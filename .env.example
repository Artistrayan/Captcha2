# ShieldCaptcha Environment Configuration Example

# Server Port (AI Studio default: 3000)
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL with Drizzle ORM)
# When provided, ShieldCaptcha connects directly to PostgreSQL via Drizzle.
# When omitted, ShieldCaptcha operates with persistent local disk storage in ./.data/
DATABASE_URL="postgresql://postgres:password@localhost:5432/shieldcaptcha"

# Firebase Authentication Admin SDK Configuration
# Optional: Required for production Firebase ID token verification.
# In development, ShieldCaptcha defaults to secure local session JWTs.
FIREBASE_PROJECT_ID="shieldcaptcha-prod"
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"shieldcaptcha-prod"}'

# Cryptographic Salts and Secrets
CAPTCHA_SERVER_SALT="replace_with_64_char_crypto_random_salt_in_production"
SESSION_JWT_SECRET="replace_with_64_char_jwt_secret_in_production"

# Rate Limiting Configuration
RATE_LIMIT_CHALLENGES_PER_MIN=120
RATE_LIMIT_VERIFY_PER_MIN=120

# AI Studio injected URLs
APP_URL="http://localhost:3000"
