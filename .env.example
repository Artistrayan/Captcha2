# ShieldCaptcha Environment Configuration Example

# Server Port (AI Studio default: 3000)
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL with Drizzle ORM)
# When provided, ShieldCaptcha connects directly to PostgreSQL via Drizzle.
# When omitted, ShieldCaptcha uses local disk storage only outside production.
DATABASE_URL="postgresql://postgres:password@localhost:5432/shieldcaptcha"

# Firebase Authentication client configuration (public API key; safe to expose in browser bundles)
VITE_FIREBASE_API_KEY="your_firebase_web_api_key"

# Firebase Authentication Admin SDK Configuration
# Required in production for Firebase ID token verification.
# Local development may use development-only session JWTs.
FIREBASE_PROJECT_ID="shieldcaptcha-prod"
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"shieldcaptcha-prod"}'

# Cryptographic Salts and Secrets
CAPTCHA_SERVER_SALT="replace_with_64_char_crypto_random_salt_in_production"
SESSION_JWT_SECRET="replace_with_64_char_jwt_secret_in_production"

# Rate Limiting Configuration
RATE_LIMIT_CHALLENGES_PER_MIN=20
RATE_LIMIT_VERIFY_PER_MIN=30

# AI Studio injected URLs
APP_URL="http://localhost:3000"

# Crypto billing (keep the real values only in Render Environment, never GitHub)
# TRON mainnet address that receives USDT TRC20; must start with T.
USDT_TRC20_RECEIVE_ADDRESS=""
# API key from your TRON data provider; used server-side only for on-chain verification.
TRON_PRO_API_KEY=""

# Email OTP delivery via Resend (verify the sender/domain in Resend first)
RESEND_API_KEY="re_your_resend_api_key"
AUTH_EMAIL_FROM="ShieldCaptcha <auth@your-verified-domain.com>"

# Google OAuth 2.0 Web client ID; enable Google provider in Firebase Authentication
VITE_GOOGLE_CLIENT_ID="your-google-oauth-web-client-id.apps.googleusercontent.com"
